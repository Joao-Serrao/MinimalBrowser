<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:id="@+id/main_container"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Custom Top Bar -->
        <LinearLayout
            android:id="@+id/top_bar"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="?attr/colorPrimary"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/title"
                android:text="@string/app_name"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="18sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content" />

            <ImageButton
                android:id="@+id/home_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/home"
                android:padding="12dp"
                android:src="@drawable/ic_home"
                app:tint="?attr/colorOnPrimary" />

            <ImageButton
                android:id="@+id/toggle_search_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/toggle_search"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_up"
                app:tint="?attr/colorOnPrimary" />

            <!--
                Previously a floating button in the root FrameLayout pinned to
                top|end, which overlapped this bar. It is a real child now.
            -->
            <ImageButton
                android:id="@+id/toggle_split_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/toggle_split"
                android:padding="12dp"
                android:src="@android:drawable/ic_menu_add"
                app:tint="?attr/colorOnPrimary" />

        </LinearLayout>

        <!-- Page load progress; shown only while the active view is loading. -->
        <ProgressBar
            android:id="@+id/progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/accent"
            android:background="@android:color/transparent"
            android:visibility="gone" />

        <!-- Search container -->
        <LinearLayout
            android:id="@+id/searchContainer"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:gravity="center_vertical"
            android:visibility="visible">

            <EditText
                android:id="@+id/search_input"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:autofillHints=""
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:inputType="textUri"
                android:selectAllOnFocus="true"
                android:singleLine="true"
                android:textColor="@color/on_top_bar"
                android:textColorHint="@color/hint" />

            <ImageButton
                android:id="@+id/search_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/search"
                android:src="@android:drawable/ic_menu_search"
                app:tint="?attr/colorOnPrimary" />
        </LinearLayout>

        <!--
            Hosts the split container plus the resize overlay, so resize mode
            cannot cover the top bar or the search field.
            Weight 1 instead of match_parent: as the third child of a vertical
            LinearLayout, match_parent pushed the panes past the screen bottom.
        -->
        <FrameLayout
            android:id="@+id/web_area"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/web_split_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/web_container_left"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

                <FrameLayout
                    android:id="@+id/web_container_right"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:visibility="gone" />
            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

</FrameLayout>
